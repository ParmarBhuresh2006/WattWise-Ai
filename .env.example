# WattWise AI - Environment Configuration Example
# Copy this file to .env and fill in your values
# Never commit the actual .env file to source control

# ─── Backend ───────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# MongoDB connection string (local only)
MONGODB_URI=mongodb://127.0.0.1:27017/wattwise

# JWT secret — change this to a long random string before use
JWT_SECRET=change_this_to_a_random_secret_at_least_32_chars
JWT_EXPIRES_IN=7d

# Frontend origin for CORS (local only)
FRONTEND_URL=http://localhost:5173

# ─── ML Engine ─────────────────────────────────────────────────
# Port for the local Python inference server (loopback only)
ML_ENGINE_PORT=8001
ML_ENGINE_HOST=127.0.0.1

# Path to the Python executable
PYTHON_PATH=python

# ─── Admin Seed ────────────────────────────────────────────────
# Used only by: npm run seed:admin
ADMIN_EMAIL=admin@wattwise.local
ADMIN_PASSWORD=Admin@WattWise2024
